        {
          "name": "Signup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueEmail = `testuser_${Date.now()}@example.com`;",
                  "pm.collectionVariables.set(\"signupEmail\", uniqueEmail);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success status\", function () {",
                  "    pm.expect(response).to.have.property(\"data\");",
                  "    pm.expect(response.data).to.have.property(\"tokenType\");",
                  "    pm.expect(response.data.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "",
                  "pm.test(\"Response contains user data\", function () {",
                  "    pm.expect(response).to.have.property(\"data\");",
                  "    pm.expect(response.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"User email is present\", function () {",
                  "    const email = response.data?.email || response.data?.user?.email;",
                  "    pm.expect(email).to.be.a(\"string\");",
                  "    pm.expect(email).to.include(\"@\");",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
