                  "const json = pm.response.json();",
                  "",
                  "// Capture cartToken from response — store in BOTH collection variables and environment",
                  "// so it stays in sync with cartItemId across individual requests and collection runs",
                  "if (json.data && json.data.cartToken) {",
                  "    pm.collectionVariables.set(\"cartToken\", json.data.cartToken);",
                  "    pm.environment.set(\"cartToken\", json.data.cartToken);",
                  "}",
                  "",
                  "",
                  "// Test: item was added successfully",
                  "pm.test(\"POST /api/cart/items returns 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Test: response has cart data",
                  "pm.test(\"Response has cart data\", function () {",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json.data).to.have.property(\"cart\");",
